# Copy this file to `.env` and fill in the values. `.env` is gitignored.

# --- Database (PostgreSQL) -------------------------------------------------
# A Postgres connection string (Neon, Supabase, Vercel Postgres, etc.).
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# --- Auth.js v5 ------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""
AUTH_TRUST_HOST=true

# First admin user. `npm run db:seed` creates it ONLY when the database has no
# users yet; on a database that already has an account the seed skips this
# entirely. Use a strong password — there is no default fallback.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""
ADMIN_NAME="Site Admin"

# --- Cloudinary (image uploads) --------------------------------------------
# From your Cloudinary dashboard → Settings → API Keys.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""

# --- Contact form email delivery (optional) --------------------------------
# Without these, contact messages are still saved to the database.
# CONTACT_TO_EMAIL is the inbox that receives submissions; leave it unset to
# use the Hero "email" value from the CMS instead.
RESEND_API_KEY=
CONTACT_TO_EMAIL="you@example.com"
CONTACT_FROM_EMAIL="Portfolio <onboarding@resend.dev>"

# --- Public site URL (optional) --------------------------------------------
# Fallback origin for canonical/OG/sitemap URLs when Admin -> Settings -> Site
# URL is empty. Last resort is the value in content/site.ts.
NEXT_PUBLIC_SITE_URL=""
